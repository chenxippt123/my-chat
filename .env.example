DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mychat?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
REGISTRATION_CODE="6688"
PORT=3000
# Passed to Next.js dev server (HMR). Usually localhost.
HOSTNAME=localhost
# TCP bind: 0.0.0.0 = accept connections on all interfaces (LAN IP like 192.168.x.x). Use 127.0.0.1 to block remote access.
LISTEN_HOST=0.0.0.0
# Production Socket.io CORS (comma-separated origins). Leave unset to allow any origin when not in dev.
# SOCKETIO_CORS_ORIGIN=https://yourdomain.com
